{
  "manifest_version": 3,
  "name": "Pew Pew Assistant Bridge",
  "version": "1.0.0",
  "description": "Security-bound Chromium extension bridge for Pew Pew Assistant desktop application.",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pew Pew Assistant"
  }
}
